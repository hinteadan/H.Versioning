<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<NuspecFile>H.Versioning.nuspec</NuspecFile>
		<NuspecBasePath>$(SolutionDir)H.Versioning</NuspecBasePath>
		<NuspecProperties>configuration=$(Configuration)</NuspecProperties>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LibGit2Sharp" Version="0.32.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="IconLogo.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
